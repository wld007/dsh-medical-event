{
  "name": "dsh-medical-event",
  "version": "0.1.0",
  "description": "病历事件还原：把病历变成可计算的事件（提及、两个时间、类型、事件归并、记录冲突）。DeepSeek Harness 插件。",
  "type": "module",
  "license": "MIT",
  "author": "wld007",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wld007/dsh-medical-event.git"
  },
  "homepage": "https://github.com/wld007/dsh-medical-event#readme",
  "bugs": {
    "url": "https://github.com/wld007/dsh-medical-event/issues"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-0"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "medical",
    "clinical-events",
    "timeline"
  ],
  "files": [
    "index.js",
    "client.js",
    "lib/**/*.js",
    "rules/**/*.mjs",
    "vendor/xlsx.mjs",
    "vendor/SheetJS-LICENSE.txt",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
